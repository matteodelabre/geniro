{
    "tasks": {
        "prod": "deno run --allow-net --allow-read=src/geniro-web/static --allow-env=READABLE_STREAM src/geniro-web/server.ts",
        "dev": "deno run --watch --allow-net --allow-read=src/geniro-web/static --allow-env=READABLE_STREAM src/geniro-web/server.ts",
        "cli": "deno run --allow-net --allow-env=READABLE_STREAM src/geniro-web/cli.ts"
    },
    "imports": {
        "@oak/commons": "jsr:@oak/commons@^1.0.1",
        "@oak/oak": "jsr:@oak/oak@^17.2.0",
        "@rdfjs/data-model": "npm:@rdfjs/data-model@^2.1.1",
        "@rdfjs/namespace": "npm:@rdfjs/namespace@^2.0.1",
        "@rdfjs/to-ntriples": "npm:@rdfjs/to-ntriples@^3.0.1",
        "@std/assert": "jsr:@std/assert@^1.0.16",
        "@std/cli": "jsr:@std/cli@^1.0.23",
        "@std/http": "jsr:@std/http@^1.0.22",
        "@std/path": "jsr:@std/path@^1.1.3",
        "@xmldom/xmldom": "npm:@xmldom/xmldom@^0.8.11",
        "graphdb": "npm:graphdb@^3.1.0-RC3",
        "preact": "npm:preact@^10.27.2",
        "preact-render-to-string": "npm:preact-render-to-string@^6.6.3",
        "rdf-sparql-builder": "npm:rdf-sparql-builder@^0.2.5",
        "sparqljson-parse": "npm:sparqljson-parse@^3.1.0",
        "unidecode": "npm:unidecode@^1.1.0"
    },
    "fmt": {
        "lineWidth": 90,
        "indentWidth": 4
    },
    "lint": {
        "rules": {
            "exclude": ["no-control-regex"]
        }
    },
    "compilerOptions": {
        "jsx": "precompile",
        "jsxImportSource": "preact"
    }
}
