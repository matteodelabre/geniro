@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix geniro: <http://diro.umontreal.ca/geniro#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

geniro: a owl:Ontology ;
    dcterms:title "Academic genealogy ontology"@en ;
    dcterms:creator [ a foaf:Person; foaf:name "Mattéo Delabre" ] .

# Date range

geniro:dateStart a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:isDefinedBy geniro: ;
    rdfs:label "Start date"@en ;
    rdfs:range xsd:date .

geniro:dateEnd a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:isDefinedBy geniro: ;
    rdfs:label "End date"@en ;
    rdfs:range xsd:date .

# geniro:Project
# Uses dcterms:title for the full title of the thesis or dissertation associated to the project, if any, otherwise full title of the project.
# Uses geniro:dateStart to specify the start date of the project
# Uses geniro:dateEnd to specify the end date of the project

geniro:Project a owl:Class ;
    rdfs:isDefinedBy geniro: ;
    rdfs:label "Academic project"@en ;
    rdfs:comment "Any project involving a student and one or multiple advisors or supervisors inside one or multiple academic institutions, that may or may not have led to an official degree and the writing of a thesis or dissertation."@en .

geniro:advisor a owl:ObjectProperty ;
    rdfs:isDefinedBy geniro: ;
    rdfs:label "Advisor"@en ;
    rdfs:comment "Person with significant involvement in supervising the student during the project (advisor, supervisor, co-advisor, co-supervisor)."@en ;
    rdfs:domain geniro:Project ;
    rdfs:range foaf:Person .

geniro:student a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:isDefinedBy geniro: ;
    rdfs:label "Student"@en ;
    rdfs:comment "Student involved in the project."@en ;
    rdfs:domain geniro:Project ;
    rdfs:range foaf:Person .

geniro:grantedBy a owl:ObjectProperty ;
    rdfs:isDefinedBy geniro: ;
    rdfs:label "Granted by"@en ;
    rdfs:comment "Authorized institution that granted the degree associated to the project."@en ;
    rdfs:domain geniro:Project ;
    rdfs:range org:Organization .

geniro:thesisURI a owl:DatatypeProperty ;
    rdfs:isDefinedBy geniro: ;
    rdfs:label "Thesis URI"@en ;
    rdfs:comment "Link to the thesis or dissertation that was written for this project."@en ;
    rdfs:domain geniro:Project ;
    rdfs:range xsd:anyURI .

geniro:MScProject a owl:Class ;
    rdfs:isDefinedBy geniro: ;
    rdfs:label "Master of Science (MSc) Degree"@en ;
    rdfs:subClassOf geniro:Project .

geniro:PhDProject a owl:Class ;
    rdfs:isDefinedBy geniro: ;
    rdfs:label "Doctor of Philosophy (PhD) Degree"@en ;
    rdfs:subClassOf geniro:Project ;
    owl:disjointWith geniro:MScProject .

# geniro:Affiliation
# Uses geniro:dateStart to specify the start date of the affiliation
# Uses geniro:dateEnd to specify the end date of the affiliation

geniro:Affiliation a owl:Class ;
    rdfs:isDefinedBy geniro: ;
    rdfs:label "Affiliation"@en ;
    rdfs:comment "Relation of affiliation between a person and an institution during a given time range."@en .

geniro:hasAffiliation a owl:ObjectProperty, owl:InverseFunctionalProperty ;
    rdfs:isDefinedBy geniro: ;
    rdfs:label "Has affiliation"@en ;
    rdfs:domain foaf:Person ;
    rdfs:range geniro:Affiliation .

geniro:affiliatedTo a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:isDefinedBy geniro: ;
    rdfs:label "Affiliated to"@en ;
    rdfs:domain geniro:Affiliation ;
    rdfs:range org:Organization .

geniro:ProfessorAffiliation a owl:Class ;
    rdfs:isDefinedBy geniro: ;
    rdfs:label "Professorship"@en ;
    rdfs:comment "Affiliation to an academic institution as a professor."@en ;
    rdfs:subClassOf geniro:Affiliation .
