@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix geniro: <http://diro.umontreal.ca/geniro#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

geniro: a owl:Ontology ;
    dcterms:title "Academic genealogy ontology"@en ;
    dcterms:creator "Mattéo Delabre" ;
    dcterms:contributor "Mattéo Delabre" ;
    dcterms:contributor "Alessandra Mancas" ;
    dcterms:contributor "Ian Arawjo" ;
    dcterms:contributor "Rémi Cérès" ;
    dcterms:contributor "Pierre Maillot" ;
    dcterms:contributor "Fabien Gandon" ;
    dcterms:created "2025-10-13"^^xsd:date ;
    vann:preferredNamespacePrefix "geniro" ;
    vann:preferredNamespaceUri "http://diro.umontreal.ca/geniro#" .

# geniro:Project
#
# - Use dcterms:title for the full title of the thesis or dissertation associated to
#   the project, if any, otherwise for the full title of the project.
# - Use dcterms:description for the abstract or description of the project.

geniro:Project a owl:Class ;
    rdfs:isDefinedBy geniro: ;
    rdfs:label "Academic project"@en ;
    rdfs:comment "Any project involving a student and one or multiple advisors or supervisors inside one or multiple academic institutions, that may or may not have led to an official degree and the writing of a thesis or dissertation."@en ;
    rdfs:subClassOf foaf:Project .

geniro:advisor a owl:ObjectProperty ;
    rdfs:isDefinedBy geniro: ;
    rdfs:label "Advisor"@en ;
    rdfs:comment "Person with significant involvement in supervising the student during the project (advisor, supervisor, co-advisor, co-supervisor)."@en ;
    rdfs:domain geniro:Project ;
    rdfs:range foaf:Person .

geniro:student a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:isDefinedBy geniro: ;
    rdfs:label "Student"@en ;
    rdfs:comment "Student involved in the project."@en ;
    rdfs:domain geniro:Project ;
    rdfs:range foaf:Person .

geniro:grantedBy a owl:ObjectProperty ;
    rdfs:isDefinedBy geniro: ;
    rdfs:label "Granted by"@en ;
    rdfs:comment "Authorized institution that granted the degree associated to the project."@en ;
    rdfs:domain geniro:Project ;
    rdfs:range org:Organization .

geniro:thesis a owl:DatatypeProperty ;
    rdfs:isDefinedBy geniro: ;
    rdfs:label "Thesis"@en ;
    rdfs:comment "Thesis or dissertation that was written for this project."@en ;
    rdfs:domain geniro:Project ;
    rdfs:range foaf:Document .

geniro:timePeriod a owl:ObjectProperty ;
    rdfs:isDefinedBy geniro: ;
    rdfs:label "Time period"@en ;
    rdfs:comment "Interval of time during which the project took place."@en ;
    rdfs:domain geniro:Project ;
    rdfs:range time:Interval .

geniro:MScProject a owl:Class ;
    rdfs:isDefinedBy geniro: ;
    rdfs:label "Master of Science (MSc) Degree"@en ;
    rdfs:subClassOf geniro:Project .

geniro:PhDProject a owl:Class ;
    rdfs:isDefinedBy geniro: ;
    rdfs:label "Doctor of Philosophy (PhD) Degree"@en ;
    rdfs:subClassOf geniro:Project ;
    owl:disjointWith geniro:MScProject .

# To describe affiliations, use instances of the org:Membership class and link them to:
#  - the affiliated person through org:member
#  - the institution through org:organization
#  - the role through org:role
#  - the affiliation period through org:memberDuring

geniro:roleDirector a org:Role ;
    skos:prefLabel "Directeur·ice"@fr ;
    skos:prefLabel "Head"@en .

geniro:roleProfessor a org:Role ;
    skos:prefLabel "Professeur·e"@fr ;
    skos:prefLabel "Professor"@en .

geniro:roleProfessorEmeritus a org:Role ;
    skos:broader geniro:professorRole ;
    skos:prefLabel "Professeur·e émérite"@fr-ca ;
    skos:prefLabel "Professor emeritus"@en .

geniro:roleProfessorFull a org:Role ;
    skos:broader geniro:professorRole ;
    skos:prefLabel "Professeur·e titulaire"@fr-ca ;
    skos:prefLabel "Full professor"@en ;
    skos:prefLabel "Professeur·e des universités"@fr-fr .

geniro:roleProfessorAssociate a org:Role ;
    skos:broader geniro:professorRole ;
    skos:prefLabel "Professeur·e agrégé·e"@fr-ca ;
    skos:prefLabel "Associate professor"@en ;
    skos:prefLabel "Maître.sse de conférences"@fr-fr .

geniro:roleProfessorAssistant a org:Role ;
    skos:broader geniro:professorRole ;
    skos:prefLabel "Professeur·e adjoint·e"@fr-ca ;
    skos:prefLabel "Assistant professor"@en .

geniro:roleStudent a org:Role ;
    skos:prefLabel "Étudiant·e"@fr ;
    skos:prefLabel "Student"@en .

# Preferred URI

geniro:preferredUri a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:isDefinedBy geniro: ;
    rdfs:label "Preferred URI"@en ;
    rdfs:comment "Canonical URI used for referring to an entity obtained by merging information from several sources (must be provided as a literal)"@en ;
    rdfs:range xsd:string .

# geniro:Mirror

geniro:Mirror a owl:Class ;
    rdfs:isDefinedBy geniro: ;
    rdfs:label "Data mirror"@en ;
    rdfs:comment "Keep track of data harvested automatically from an external source"@en .

geniro:entity a owl:DatatypeProperty ;
    rdfs:isDefinedBy geniro: ;
    rdfs:label "Mirrored entity"@en ;
    rdfs:comment "Entity, designated as a literal URI, that is created by a data mirror. All triples of which this entity is a subject or an object represent data mirrored from an external source"@en ;
    rdfs:range xsd:dateTime .

geniro:updated a owl:DatatypeProperty ;
    rdfs:isDefinedBy geniro: ;
    rdfs:label "Last update time"@en ;
    rdfs:comment "Date and time at which the external information was last updated"@en ;
    rdfs:range xsd:dateTime .

geniro:expires a owl:DatatypeProperty ;
    rdfs:isDefinedBy geniro: ;
    rdfs:label "Expiration time"@en ;
    rdfs:comment "Date and time at which the external information should be refreshed"@en ;
    rdfs:range xsd:dateTime .
